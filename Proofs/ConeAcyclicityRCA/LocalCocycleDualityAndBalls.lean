import Proofs.ConeAcyclicityRCA.IteratedCylinderLinkInvariants

/-!
# Local-Cocycle Extension Duality and Euclidean Ball Containment Across Welded Cells

Proves the finite-dimensional Fredholm duality equivalence local_gen_iff_localCocycleExtends between local stabilizer generation of global cocycles supported in a ball (globalStabilizersInBall ⊆ locallyGeneratedInBall) and global extension of relative cocycles (LocalCocycleExtends). Defines HasCoarseEdgeBound and establishes Euclidean Ball3D containment estimates across LLL coordinate perturbation, barycentric subdivision, and three-layer cylinder cells.

## References

* Part I, Section 2.2 (`subsec:step1-lll`), Proposition 2.4 (`prop:step1-lll`)
* Part I, Section 3.1 (`subsec:rca-trinity`), Definition 3.1 (`def:rca`), Proposition 3.3 (`prop:trinity-equivalence`)
* Part II, Section 2 (`subsec:setup`), Definition 2.2 (`def:RCA`)
-/

noncomputable section
open scoped Classical BigOperators
namespace WeldedHierarchy

/-! ## 1. Equivalence of `locallyGeneratedInBall` and `LocalCocycleExtends` -/

/-- Lower bound `(10000 : ℝ) ≤ bdlLambda` (`bdlLambda = 500000000`). -/
lemma bdlLambda_ge_10000 : (10000 : ℝ) ≤ (bdlLambda : ℝ) := by
  dsimp [bdlLambda]; norm_num

/-- Derived spatial support of a 1-chain `g : Q → ZMod 2` in `ℝ³`. -/
def supp1 {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (code : CSSCode3D Q M_Z M_X) (g : Q → ZMod 2) : Set Point3D :=
  {x : Point3D | ∃ q : Q, g q ≠ 0 ∧ code.posQ q = x}

/-- Derived spatial support of a 2-chain `c2 : M_Z → ZMod 2` in `ℝ³`. -/
def supp2 {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (code : CSSCode3D Q M_Z M_X) (c2 : M_Z → ZMod 2) : Set Point3D :=
  {x : Point3D | ∃ m : M_Z, c2 m ≠ 0 ∧ code.posZ m = x}

/-- Global stabilizers (syndrome-free 1-chains) supported within `B(x_0, r)`. -/
def globalStabilizersInBall {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (code : CSSCode3D Q M_Z M_X) (x0 : Point3D) (r : ℝ) : Set (Q → ZMod 2) :=
  {g : (Q → ZMod 2) | syndrome code g = 0 ∧ supp1 code g ⊆ ball3D x0 r}

/-- 1-boundaries `checkGen code c2` generated by $Z$-checks `m : M_Z` whose check centers lie in
    `ball3D x0 R`, i.e., `supp2 code c2 ⊆ ball3D x0 R` (`c2 m ≠ 0 → code.posZ m ∈ ball3D x0 R`),
    matching the check-center membership convention noted in Remark 3.4 (`rem:cube-transfer`) of
    Part I. -/
def locallyGeneratedInBall {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (code : CSSCode3D Q M_Z M_X) (x0 : Point3D) (R : ℝ) : Set (Q → ZMod 2) :=
  {g : (Q → ZMod 2) | ∃ c2 : (M_Z → ZMod 2), supp2 code c2 ⊆ ball3D x0 R ∧ checkGen code c2 = g}

/-- Monotonicity of closed 3D Euclidean balls: if `0 ≤ r ≤ R`, then `B(x_0, r) ⊆ B(x_0, R)`. -/
lemma ball3D_mono (x0 : Point3D) {r R : ℝ} (hr : 0 ≤ r) (h : r ≤ R) :
    ball3D x0 r ⊆ ball3D x0 R := by
  intro x hx
  dsimp [ball3D] at hx ⊢
  have h_sq : r ^ 2 ≤ R ^ 2 := sq_le_sq.mpr (by
    rw [abs_of_nonneg hr, abs_of_nonneg (le_trans hr h)]
    exact h)
  exact le_trans hx h_sq

/-- Expresses `triGridPos3D pX pQ pZ m u v` as a nested convex combination of `subdividePoint3D`. -/
lemma triGridPos3D_eq_subdividePoint3D (pX pQ pZ : Point3D) (m u v : ℕ)
    (hu : 0 < u) (hvu : v ≤ u) :
    triGridPos3D pX pQ pZ m u v =
      subdividePoint3D pX (subdividePoint3D pQ pZ u v) m u := by
  ext axis
  dsimp [triGridPos3D, subdividePoint3D]
  have h_sub : ((u - v : ℕ) : ℝ) = (u : ℝ) - (v : ℝ) := Nat.cast_sub hvu
  rw [h_sub]
  have hu_ne : (u : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hu)
  by_cases hm : m = 0
  · subst hm; simp
  · have hm_ne : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hm
    field_simp [hu_ne, hm_ne]
    ring

/-- Integer truncation depth selection for `1 ≤ r ≤ lam ^ N` (`2 ≤ lam`). -/
lemma exists_truncation_depth {lam : ℝ} (hlam : 2 ≤ lam) (N : ℕ) (r : ℝ)
    (hr_ge_one : 1 ≤ r) (hr_le : r ≤ lam ^ N) :
    ∃ m : ℕ, m ≤ N ∧ r ≤ lam ^ m ∧ lam ^ m ≤ lam * r := by
  induction N with
  | zero =>
    use 0
    simp only [le_refl, pow_zero, true_and]
    have hr_eq_one : r = 1 := le_antisymm hr_le hr_ge_one
    rw [hr_eq_one]
    constructor <;> linarith
  | succ N ih =>
    by_cases h_le_N : r ≤ lam ^ N
    · obtain ⟨m, hm_le, hr_m, hm_r⟩ := ih h_le_N
      exact ⟨m, Nat.le_succ_of_le hm_le, hr_m, hm_r⟩
    · push_neg at h_le_N
      use N + 1
      refine ⟨le_refl (N + 1), hr_le, ?_⟩
      rw [pow_succ']
      have hlam_pos : 0 ≤ lam := by linarith
      exact mul_le_mul_of_nonneg_left (le_of_lt h_le_N) hlam_pos

/-- **Dual Cocycle Extension Property (`LocalCocycleExtends`):**
    Every 1-cochain `h : Q → ZMod 2` whose dual syndrome vanishes on `Ball3D x0 R` agrees on `Ball3D x0 r`
    with some global X-check coboundary `checkGen (dualCode code) d2`. -/
def LocalCocycleExtends {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (code : CSSCode3D Q M_Z M_X) (x0 : Point3D) (r R : ℝ) : Prop :=
  ∀ h : Q → ZMod 2,
    (∀ mZ : M_Z, code.posZ mZ ∈ ball3D x0 R → syndrome (dualCode code) h mZ = 0) →
    ∃ d2 : M_X → ZMod 2,
      ∀ q : Q, code.posQ q ∈ ball3D x0 r → h q = checkGen (dualCode code) d2 q

/-- **Fredholm Duality for Local Generation (`local_gen_of_localCocycleExtends`):**
    `LocalCocycleExtends code x0 r R` implies `globalStabilizersInBall code x0 r ⊆ locallyGeneratedInBall code x0 R`. -/
theorem local_gen_of_localCocycleExtends {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (code : CSSCode3D Q M_Z M_X) (x0 : Point3D) (r R : ℝ)
    (h_ext : LocalCocycleExtends code x0 r R) :
    globalStabilizersInBall code x0 r ⊆ locallyGeneratedInBall code x0 R := by
  intro g ⟨hg_syn, hg_supp⟩
  let S_Z : Set (M_Z → ZMod 2) := {c2 | supp2 code c2 ⊆ ball3D x0 R}
  have h0_mem : (0 : M_Z → ZMod 2) ∈ S_Z := by
    intro p ⟨mZ, hmZ, _⟩; exact False.elim (hmZ rfl)
  have hadd_mem : ∀ {a b : M_Z → ZMod 2}, a ∈ S_Z → b ∈ S_Z → a + b ∈ S_Z := by
    intro a b ha hb p ⟨mZ, hmZ, hp⟩
    by_cases ha_mZ : a mZ ≠ 0
    · exact ha ⟨mZ, ha_mZ, hp⟩
    · push_neg at ha_mZ
      have hb_mZ : b mZ ≠ 0 := by
        intro hb0; apply hmZ; dsimp; rw [ha_mZ, hb0, add_zero]
      exact hb ⟨mZ, hb_mZ, hp⟩
  let W : Submodule (ZMod 2) (Q → ZMod 2) :=
    { carrier := locallyGeneratedInBall code x0 R
      add_mem' := by
        rintro _ _ ⟨c2a, ha, rfl⟩ ⟨c2b, hb, rfl⟩
        exact ⟨c2a + c2b, hadd_mem ha hb, map_add (checkGen code) c2a c2b⟩
      zero_mem' := ⟨0, h0_mem, map_zero (checkGen code)⟩
      smul_mem' := by
        rintro c _ ⟨c2, hc2, rfl⟩
        refine ⟨c • c2, ?_, ?_⟩
        · intro p ⟨mZ, hmZ, hp⟩
          have hc2_mZ : c2 mZ ≠ 0 := by
            intro h0; apply hmZ; change c * c2 mZ = 0; rw [h0, mul_zero]
          exact hc2 ⟨mZ, hc2_mZ, hp⟩
        · ext q
          change (∑ mZ, code.checkZ mZ q * (c * c2 mZ)) = c * ∑ mZ, code.checkZ mZ q * c2 mZ
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro mZ _
          ring }
  change g ∈ W.carrier
  apply mem_of_dualPairing_ortho W g
  intro h hh_ortho
  have h_dual_syn : ∀ mZ : M_Z, code.posZ mZ ∈ ball3D x0 R → syndrome (dualCode code) h mZ = 0 := by
    intro mZ hmZ
    have h_single_mem : checkGen code (singleQubit mZ) ∈ W := by
      refine ⟨singleQubit mZ, ?_, rfl⟩
      intro p ⟨mZ', hmZ', hp⟩
      rw [← hp]
      have h_eq : mZ' = mZ := by
        by_contra hne; exact hmZ' (if_neg hne)
      subst h_eq; exact hmZ
    have h_pair := hh_ortho (checkGen code (singleQubit mZ)) h_single_mem
    rw [dualPairing_checkGen_primal] at h_pair
    rw [Finset.sum_eq_single mZ] at h_pair
    · simpa [singleQubit] using h_pair
    · intro mZ' _ hne; simp [singleQubit, hne]
    · intro h_abs; exact False.elim (h_abs (Finset.mem_univ mZ))
  obtain ⟨d2, hd2⟩ := h_ext h h_dual_syn
  have h_pair_eq : dualPairing g h = dualPairing g (checkGen (dualCode code) d2) := by
    dsimp [dualPairing]
    apply Finset.sum_congr rfl
    intro q _
    by_cases hq : g q = 0
    · rw [hq, zero_mul, zero_mul]
    · have hq_in : code.posQ q ∈ ball3D x0 r := hg_supp ⟨q, hq, rfl⟩
      rw [hd2 q hq_in]
  rw [h_pair_eq, dualPairing_checkGen_dual, hg_syn]
  simp

/-- **Converse Fredholm Duality (`localCocycleExtends_of_local_gen`):**
    `globalStabilizersInBall code x0 r ⊆ locallyGeneratedInBall code x0 R` implies `LocalCocycleExtends code x0 r R`. -/
theorem localCocycleExtends_of_local_gen {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (code : CSSCode3D Q M_Z M_X) (x0 : Point3D) (r R : ℝ)
    (h_gen : globalStabilizersInBall code x0 r ⊆ locallyGeneratedInBall code x0 R) :
    LocalCocycleExtends code x0 r R := by
  intro h hh_syn
  let U_set : Set (Q → ZMod 2) :=
    {u | ∃ d2 : M_X → ZMod 2, ∀ q : Q, code.posQ q ∈ ball3D x0 r → u q = checkGen (dualCode code) d2 q}
  have h0_U : (0 : Q → ZMod 2) ∈ U_set := by
    refine ⟨0, fun q _ => ?_⟩
    rw [map_zero]
  have hadd_U : ∀ {a b : Q → ZMod 2}, a ∈ U_set → b ∈ U_set → a + b ∈ U_set := by
    rintro a b ⟨d2a, ha⟩ ⟨d2b, hb⟩
    refine ⟨d2a + d2b, fun q hq => ?_⟩
    rw [map_add]
    change a q + b q = checkGen (dualCode code) d2a q + checkGen (dualCode code) d2b q
    rw [ha q hq, hb q hq]
  let U : Submodule (ZMod 2) (Q → ZMod 2) :=
    { carrier := U_set
      add_mem' := fun ha hb => hadd_U ha hb
      zero_mem' := h0_U
      smul_mem' := by
        rintro c _ ⟨d2, hd2⟩
        refine ⟨c • d2, fun q hq => ?_⟩
        change c * _ = _
        rw [hd2 q hq]
        change c * (∑ mX, code.checkX mX q * d2 mX) = ∑ mX, code.checkX mX q * (c * d2 mX)
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro mX _
        ring }
  change h ∈ U.carrier
  apply mem_of_dualPairing_ortho U h
  intro g hg_ortho
  have hg_supp : supp1 code g ⊆ ball3D x0 r := by
    intro p ⟨q, hq_ne, hp⟩
    rw [← hp]
    by_contra hq_not_in
    have h_single_U : singleQubit q ∈ U := by
      refine ⟨0, fun q' hq'_in => ?_⟩
      have hne : q' ≠ q := fun heq => hq_not_in (heq ▸ hq'_in)
      rw [map_zero]
      dsimp [singleQubit]
      rw [if_neg hne]
    have h_pair := hg_ortho (singleQubit q) h_single_U
    rw [dualPairing_singleQubit_left] at h_pair
    exact hq_ne h_pair
  have hg_syn : syndrome code g = 0 := by
    ext mX
    have h_chk_U : checkGen (dualCode code) (singleQubit mX) ∈ U :=
      ⟨singleQubit mX, fun _ _ => rfl⟩
    have h_pair := hg_ortho (checkGen (dualCode code) (singleQubit mX)) h_chk_U
    have h_symm : dualPairing (checkGen (dualCode code) (singleQubit mX)) g =
        dualPairing g (checkGen (dualCode code) (singleQubit mX)) := by
      dsimp [dualPairing]; apply Finset.sum_congr rfl; intro q _; ring
    rw [h_symm, dualPairing_checkGen_dual] at h_pair
    rw [Finset.sum_eq_single mX] at h_pair
    · simpa [singleQubit] using h_pair
    · intro mX' _ hne; simp [singleQubit, hne]
    · intro h_abs; exact False.elim (h_abs (Finset.mem_univ mX))
  obtain ⟨c2, hc2_supp, rfl⟩ := h_gen ⟨hg_syn, hg_supp⟩
  have h_symm : dualPairing h (checkGen code c2) = dualPairing (checkGen code c2) h := by
    dsimp [dualPairing]; apply Finset.sum_congr rfl; intro q _; ring
  rw [h_symm, dualPairing_checkGen_primal]
  apply Finset.sum_eq_zero
  intro mZ _
  by_cases hmZ : c2 mZ = 0
  · rw [hmZ, zero_mul]
  · rw [hh_syn mZ (hc2_supp ⟨mZ, hmZ, rfl⟩), mul_zero]

/-- **Exact Equivalence Between Primal Local Generation and Dual Cocycle Extension (`local_gen_iff_localCocycleExtends`):** -/
theorem local_gen_iff_localCocycleExtends {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (code : CSSCode3D Q M_Z M_X) (x0 : Point3D) (r R : ℝ) :
    (globalStabilizersInBall code x0 r ⊆ locallyGeneratedInBall code x0 R) ↔
    LocalCocycleExtends code x0 r R :=
  ⟨localCocycleExtends_of_local_gen code x0 r R, local_gen_of_localCocycleExtends code x0 r R⟩

/-- Triangle inequality for `ball3D`: if `p ∈ Ball3D x0 r` and `distSq3D q p ≤ D ^ 2`
    with `0 ≤ r` and `0 ≤ D`, then `q ∈ Ball3D x0 (r + D)`. -/
lemma ball3D_step_of_distSq3D_le (x0 p q : Point3D) {r D : ℝ}
    (hr : 0 ≤ r) (hD : 0 ≤ D)
    (hp : p ∈ ball3D x0 r) (hqp : distSq3D q p ≤ D ^ 2) :
    q ∈ ball3D x0 (r + D) := by
  dsimp [ball3D, distSq3D] at hp hqp ⊢
  rcases eq_or_lt_of_le hr with rfl | hr_pos
  · have hp0 : p 0 = x0 0 := by
      nlinarith [sq_nonneg (p 0 - x0 0), sq_nonneg (p 1 - x0 1), sq_nonneg (p 2 - x0 2)]
    have hp1 : p 1 = x0 1 := by
      nlinarith [sq_nonneg (p 0 - x0 0), sq_nonneg (p 1 - x0 1), sq_nonneg (p 2 - x0 2)]
    have hp2 : p 2 = x0 2 := by
      nlinarith [sq_nonneg (p 0 - x0 0), sq_nonneg (p 1 - x0 1), sq_nonneg (p 2 - x0 2)]
    rw [← hp0, ← hp1, ← hp2, zero_add]
    exact hqp
  · rcases eq_or_lt_of_le hD with rfl | hD_pos
    · have hq0 : q 0 = p 0 := by
        nlinarith [sq_nonneg (q 0 - p 0), sq_nonneg (q 1 - p 1), sq_nonneg (q 2 - p 2)]
      have hq1 : q 1 = p 1 := by
        nlinarith [sq_nonneg (q 0 - p 0), sq_nonneg (q 1 - p 1), sq_nonneg (q 2 - p 2)]
      have hq2 : q 2 = p 2 := by
        nlinarith [sq_nonneg (q 0 - p 0), sq_nonneg (q 1 - p 1), sq_nonneg (q 2 - p 2)]
      rw [hq0, hq1, hq2, add_zero]
      exact hp
    · have h_id :
        r * D * ((q 0 - x0 0) ^ 2 + (q 1 - x0 1) ^ 2 + (q 2 - x0 2) ^ 2) +
        ((D * (p 0 - x0 0) - r * (q 0 - p 0)) ^ 2 +
         (D * (p 1 - x0 1) - r * (q 1 - p 1)) ^ 2 +
         (D * (p 2 - x0 2) - r * (q 2 - p 2)) ^ 2) =
        D * (r + D) * ((p 0 - x0 0) ^ 2 + (p 1 - x0 1) ^ 2 + (p 2 - x0 2) ^ 2) +
        r * (r + D) * ((q 0 - p 0) ^ 2 + (q 1 - p 1) ^ 2 + (q 2 - p 2) ^ 2) := by ring
      have h1 : D * (r + D) * ((p 0 - x0 0) ^ 2 + (p 1 - x0 1) ^ 2 + (p 2 - x0 2) ^ 2) ≤
          D * (r + D) * r ^ 2 := mul_le_mul_of_nonneg_left hp (by positivity)
      have h2 : r * (r + D) * ((q 0 - p 0) ^ 2 + (q 1 - p 1) ^ 2 + (q 2 - p 2) ^ 2) ≤
          r * (r + D) * D ^ 2 := mul_le_mul_of_nonneg_left hqp (by positivity)
      have h3 : D * (r + D) * r ^ 2 + r * (r + D) * D ^ 2 = r * D * (r + D) ^ 2 := by ring
      have h_sq : 0 ≤ (D * (p 0 - x0 0) - r * (q 0 - p 0)) ^ 2 +
          (D * (p 1 - x0 1) - r * (q 1 - p 1)) ^ 2 +
          (D * (p 2 - x0 2) - r * (q 2 - p 2)) ^ 2 := by positivity
      have hrD : 0 < r * D := mul_pos hr_pos hD_pos
      nlinarith

/-- Convexity of `ball3D` under `subdividePoint3D`: if `p, q ∈ Ball3D x0 R` and `j ≤ L`,
    then `subdividePoint3D p q L j ∈ Ball3D x0 R`. -/
lemma subdividePoint3D_mem_ball3D (x0 p q : Point3D) (L j : ℕ) (R : ℝ)
    (hj : j ≤ L) (hp : p ∈ ball3D x0 R) (hq : q ∈ ball3D x0 R) :
    subdividePoint3D p q L j ∈ ball3D x0 R := by
  by_cases hL : L = 0
  · subst hL
    have hj0 : j = 0 := Nat.eq_zero_of_le_zero hj
    subst hj0
    have h_eq : subdividePoint3D p q 0 0 = p := by
      ext axis; dsimp [subdividePoint3D]; simp
    rw [h_eq]; exact hp
  · dsimp [ball3D, distSq3D, subdividePoint3D] at hp hq ⊢
    have hL_pos : (0 : ℝ) < (L : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hL)
    let t : ℝ := (j : ℝ) / (L : ℝ)
    have ht0 : 0 ≤ t := div_nonneg (Nat.cast_nonneg j) (le_of_lt hL_pos)
    have ht1 : 0 ≤ 1 - t := sub_nonneg.mpr ((div_le_one hL_pos).mpr (Nat.cast_le.mpr hj))
    have h_id :
      ((p 0 + t * (q 0 - p 0) - x0 0) ^ 2 +
       (p 1 + t * (q 1 - p 1) - x0 1) ^ 2 +
       (p 2 + t * (q 2 - p 2) - x0 2) ^ 2) +
      (1 - t) * t * ((p 0 - q 0) ^ 2 + (p 1 - q 1) ^ 2 + (p 2 - q 2) ^ 2) =
      (1 - t) * ((p 0 - x0 0) ^ 2 + (p 1 - x0 1) ^ 2 + (p 2 - x0 2) ^ 2) +
      t * ((q 0 - x0 0) ^ 2 + (q 1 - x0 1) ^ 2 + (q 2 - x0 2) ^ 2) := by ring
    have h_nonneg : 0 ≤ (1 - t) * t * ((p 0 - q 0) ^ 2 + (p 1 - q 1) ^ 2 + (p 2 - q 2) ^ 2) := by
      positivity
    have h1 : (1 - t) * ((p 0 - x0 0) ^ 2 + (p 1 - x0 1) ^ 2 + (p 2 - x0 2) ^ 2) ≤ (1 - t) * R ^ 2 :=
      mul_le_mul_of_nonneg_left hp ht1
    have h2 : t * ((q 0 - x0 0) ^ 2 + (q 1 - x0 1) ^ 2 + (q 2 - x0 2) ^ 2) ≤ t * R ^ 2 :=
      mul_le_mul_of_nonneg_left hq ht0
    linarith

/-- Convexity of `ball3D` under `triGridPos3D`: if `pX, pQ, pZ ∈ Ball3D x0 R` and `0 < u`, `v ≤ u ≤ m`,
    then `triGridPos3D pX pQ pZ m u v ∈ Ball3D x0 R`. -/
lemma triGridPos3D_mem_ball3D (x0 pX pQ pZ : Point3D) (m u v : ℕ) (R : ℝ)
    (hu : 0 < u) (hvu : v ≤ u) (hum : u ≤ m)
    (hpX : pX ∈ ball3D x0 R) (hpQ : pQ ∈ ball3D x0 R) (hpZ : pZ ∈ ball3D x0 R) :
    triGridPos3D pX pQ pZ m u v ∈ ball3D x0 R := by
  rw [triGridPos3D_eq_subdividePoint3D pX pQ pZ m u v hu hvu]
  exact subdividePoint3D_mem_ball3D x0 pX (subdividePoint3D pQ pZ u v) m u R hum hpX
    (subdividePoint3D_mem_ball3D x0 pQ pZ u v R hvu hpQ hpZ)

/-! ## 2. Euclidean Ball Inclusion Across Rescaling and Perturbation -/

/-- Scaling + shift ball inclusion for `bdlPerturbStep`:
    if `(fun axis => (L : ℝ) * p axis + c axis) ∈ Ball3D x0 r` with `0 < L`, `0 ≤ r`, `0 ≤ C_shift`,
    and `distSq3D c 0 ≤ (C_shift * L) ^ 2`, then `p ∈ Ball3D (x0 / L) (r / L + C_shift)`. -/
lemma perturb_point_mem_coarse_ball (x0 p c : Point3D) (L : ℕ) (hL : 0 < L)
    {r C_shift : ℝ} (hr : 0 ≤ r) (hC : 0 ≤ C_shift)
    (hc : distSq3D c (fun _ => 0) ≤ (C_shift * (L : ℝ)) ^ 2)
    (hp : (fun axis => (L : ℝ) * p axis + c axis) ∈ ball3D x0 r) :
    p ∈ ball3D (fun axis => x0 axis / (L : ℝ)) (r / (L : ℝ) + C_shift) := by
  have hL_pos : (0 : ℝ) < (L : ℝ) := Nat.cast_pos.mpr hL
  have hL_ne : (L : ℝ) ≠ 0 := ne_of_gt hL_pos
  have h_dist : distSq3D (fun axis => (L : ℝ) * p axis)
      (fun axis => (L : ℝ) * p axis + c axis) ≤ (C_shift * (L : ℝ)) ^ 2 := by
    dsimp [distSq3D] at hc ⊢
    have h_eq : ((L : ℝ) * p 0 - ((L : ℝ) * p 0 + c 0)) ^ 2 +
        ((L : ℝ) * p 1 - ((L : ℝ) * p 1 + c 1)) ^ 2 +
        ((L : ℝ) * p 2 - ((L : ℝ) * p 2 + c 2)) ^ 2 =
        (c 0 - 0) ^ 2 + (c 1 - 0) ^ 2 + (c 2 - 0) ^ 2 := by ring
    rw [h_eq]; exact hc
  have h_scaled := ball3D_step_of_distSq3D_le x0
    (fun axis => (L : ℝ) * p axis + c axis) (fun axis => (L : ℝ) * p axis)
    hr (mul_nonneg hC (le_of_lt hL_pos)) hp h_dist
  dsimp [ball3D, distSq3D] at h_scaled ⊢
  have h_lhs : (((L : ℝ) * p 0 - x0 0) ^ 2 + ((L : ℝ) * p 1 - x0 1) ^ 2 + ((L : ℝ) * p 2 - x0 2) ^ 2) =
      (L : ℝ) ^ 2 * ((p 0 - x0 0 / (L : ℝ)) ^ 2 + (p 1 - x0 1 / (L : ℝ)) ^ 2 + (p 2 - x0 2 / (L : ℝ)) ^ 2) := by
    field_simp [hL_ne]
  have h_rhs : (r + C_shift * (L : ℝ)) ^ 2 = (L : ℝ) ^ 2 * (r / (L : ℝ) + C_shift) ^ 2 := by
    field_simp [hL_ne]
  rw [h_lhs, h_rhs] at h_scaled
  have hL2_pos : (0 : ℝ) < (L : ℝ) ^ 2 := sq_pos_of_pos hL_pos
  nlinarith

/-- Converse scaling + shift ball inclusion for `bdlPerturbStep`:
    if `p ∈ Ball3D (x0 / L) r_coarse` with `0 < L`, `0 ≤ r_coarse`, `0 ≤ C_shift`,
    and `distSq3D c 0 ≤ (C_shift * L) ^ 2`, then `(fun axis => (L : ℝ) * p axis + c axis) ∈ Ball3D x0 ((L : ℝ) * (r_coarse + C_shift))`. -/
lemma coarse_ball_mem_perturb_point (x0 p c : Point3D) (L : ℕ) (hL : 0 < L)
    {r_coarse C_shift : ℝ} (hr : 0 ≤ r_coarse) (hC : 0 ≤ C_shift)
    (hc : distSq3D c (fun _ => 0) ≤ (C_shift * (L : ℝ)) ^ 2)
    (hp : p ∈ ball3D (fun axis => x0 axis / (L : ℝ)) r_coarse) :
    (fun axis => (L : ℝ) * p axis + c axis) ∈ ball3D x0 ((L : ℝ) * (r_coarse + C_shift)) := by
  have hL_pos : (0 : ℝ) < (L : ℝ) := Nat.cast_pos.mpr hL
  have hL_ne : (L : ℝ) ≠ 0 := ne_of_gt hL_pos
  have hp_scaled : (fun axis => (L : ℝ) * p axis) ∈ ball3D x0 ((L : ℝ) * r_coarse) := by
    dsimp [ball3D, distSq3D] at hp ⊢
    have h_lhs : (((L : ℝ) * p 0 - x0 0) ^ 2 + ((L : ℝ) * p 1 - x0 1) ^ 2 + ((L : ℝ) * p 2 - x0 2) ^ 2) =
        (L : ℝ) ^ 2 * ((p 0 - x0 0 / (L : ℝ)) ^ 2 + (p 1 - x0 1 / (L : ℝ)) ^ 2 + (p 2 - x0 2 / (L : ℝ)) ^ 2) := by
      field_simp [hL_ne]
    have h_rhs : ((L : ℝ) * r_coarse) ^ 2 = (L : ℝ) ^ 2 * r_coarse ^ 2 := by ring
    rw [h_lhs, h_rhs]
    exact mul_le_mul_of_nonneg_left hp (sq_nonneg (L : ℝ))
  have h_dist : distSq3D (fun axis => (L : ℝ) * p axis + c axis)
      (fun axis => (L : ℝ) * p axis) ≤ (C_shift * (L : ℝ)) ^ 2 := by
    dsimp [distSq3D] at hc ⊢
    have h_eq : (((L : ℝ) * p 0 + c 0) - (L : ℝ) * p 0) ^ 2 +
        (((L : ℝ) * p 1 + c 1) - (L : ℝ) * p 1) ^ 2 +
        (((L : ℝ) * p 2 + c 2) - (L : ℝ) * p 2) ^ 2 =
        (c 0 - 0) ^ 2 + (c 1 - 0) ^ 2 + (c 2 - 0) ^ 2 := by ring
    rw [h_eq]; exact hc
  have h_step := ball3D_step_of_distSq3D_le x0
    (fun axis => (L : ℝ) * p axis) (fun axis => (L : ℝ) * p axis + c axis)
    (mul_nonneg (le_of_lt hL_pos) hr) (mul_nonneg hC (le_of_lt hL_pos)) hp_scaled h_dist
  have h_rad : (L : ℝ) * r_coarse + C_shift * (L : ℝ) = (L : ℝ) * (r_coarse + C_shift) := by ring
  rw [h_rad] at h_step
  exact h_step

/-! ## 3. Cylinder Cell Metric Ball-Inclusion Lemmas -/

/-- Symbolic coarse edge bound `HasCoarseEdgeBound pcode D_edge`:
    every active coarse `(x, q)` or `(z, q)` pair has `distSq3D ≤ D_edge ^ 2`. -/
def HasCoarseEdgeBound {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (D_edge : ℝ) : Prop :=
  0 ≤ D_edge ∧
  (∀ (z : M_Z) (q : Q), pcode.checkZ z q ≠ 0 → distSq3D (pcode.posQ q) (pcode.posZ z) ≤ D_edge ^ 2) ∧
  (∀ (x : M_X) (q : Q), pcode.checkX x q ≠ 0 → distSq3D (pcode.posQ q) (pcode.posX x) ≤ D_edge ^ 2)

/-- Every boundary X-vertex `boundaryX0Pos pcode u` lies within `D_edge` of its owner `pcode.posX u.val.1`. -/
lemma boundaryX0Pos_mem_ball3D_of_posX {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (x : M_X)
    (hx : pcode.posX x ∈ ball3D x0 r)
    (xv : BoundaryX0Link pcode M) (hxv : xv.val.1 = x) :
    boundaryX0Pos pcode M xv.val.2 ∈ ball3D x0 (r + 2 * D_edge) := by
  rcases hD with ⟨hD0, hZ_edge, hX_edge⟩
  rcases xv with ⟨⟨x', v⟩, hp⟩
  (try dsimp at hxv); subst hxv
  have h_q_in : ∀ q : Q, pcode.checkX x' q ≠ 0 → pcode.posQ q ∈ ball3D x0 (r + 2 * D_edge) := by
    intro q hxq
    have h1 := ball3D_step_of_distSq3D_le x0 (pcode.posX x') (pcode.posQ q) hr hD0 hx (hX_edge x' q hxq)
    exact ball3D_mono x0 (by linarith) (by linarith) h1
  have h_z_in : ∀ (q : Q) (z : M_Z), pcode.checkX x' q ≠ 0 → pcode.checkZ z q ≠ 0 →
      pcode.posZ z ∈ ball3D x0 (r + 2 * D_edge) := by
    intro q z hxq hzq
    have hq1 := ball3D_step_of_distSq3D_le x0 (pcode.posX x') (pcode.posQ q) hr hD0 hx (hX_edge x' q hxq)
    have hz1 := ball3D_step_of_distSq3D_le x0 (pcode.posQ q) (pcode.posZ z) (by linarith) hD0 hq1
      (by rw [distSq3D_comm]; exact hZ_edge z q hzq)
    have h_eq : r + D_edge + D_edge = r + 2 * D_edge := by ring
    rw [h_eq] at hz1; exact hz1
  rcases v with q | ⟨⟨eZ, j⟩ | z⟩
  · exact h_q_in q hp
  · exact subdividePoint3D_mem_ball3D x0 (pcode.posQ eZ.val.1) (pcode.posZ eZ.val.2)
      (M + 1) (j.val + 1) (r + 2 * D_edge) (by omega)
      (h_q_in eZ.val.1 hp) (h_z_in eZ.val.1 eZ.val.2 hp eZ.property)
  · rcases hp with ⟨q, hxq, hzq⟩
    exact h_z_in q z hxq hzq

/-- Every shell vertex `shellVertexPos pcode M sv` lies within `D_edge` of its owner `pcode.posX`. -/
lemma shellVertexPos_mem_ball3D_of_posX {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (x : M_X)
    (hx : pcode.posX x ∈ ball3D x0 r)
    (sv : ShellVertex pcode M) (hsv : sv.val.1.val.1 = x) :
    shellVertexPos pcode M sv ∈ ball3D x0 (r + 2 * D_edge) := by
  have hD0 := hD.1
  have hx' : pcode.posX x ∈ ball3D x0 (r + 2 * D_edge) :=
    ball3D_mono x0 hr (by linarith) hx
  rcases sv with ⟨⟨⟨⟨x', v⟩, hp⟩, r_idx⟩, h_in⟩
  (try dsimp at hsv); subst hsv
  have h_bx := boundaryX0Pos_mem_ball3D_of_posX pcode M hD x0 hr x' hx ⟨(x', v), hp⟩ rfl
  rcases v with q | ⟨⟨eZ, j⟩ | z⟩
  · dsimp [shellVertexPos]
    exact subdividePoint3D_mem_ball3D x0 (pcode.posX x') (pcode.posQ q)
      (M + 1) (r_idx.val + 1) (r + 2 * D_edge) (Nat.succ_le_of_lt r_idx.isLt) hx' h_bx
  · dsimp [shellVertexPos]
    dsimp [InShellR] at h_in
    have hq_in := boundaryX0Pos_mem_ball3D_of_posX pcode M hD x0 hr x' hx ⟨(x', Sum.inl eZ.val.1), hp⟩ rfl
    have hz_in := boundaryX0Pos_mem_ball3D_of_posX pcode M hD x0 hr x' hx
      ⟨(x', Sum.inr (Sum.inr eZ.val.2)), ⟨eZ.val.1, hp, eZ.property⟩⟩ rfl
    exact triGridPos3D_mem_ball3D x0 (pcode.posX x') (pcode.posQ eZ.val.1) (pcode.posZ eZ.val.2)
      (M + 1) (r_idx.val + 1) (j.val + 1) (r + 2 * D_edge)
      (Nat.succ_pos r_idx.val) (by omega) (Nat.succ_le_of_lt r_idx.isLt) hx' hq_in hz_in
  · dsimp [shellVertexPos]
    exact subdividePoint3D_mem_ball3D x0 (pcode.posX x') (pcode.posZ z)
      (M + 1) (r_idx.val + 1) (r + 2 * D_edge) (Nat.succ_le_of_lt r_idx.isLt) hx' h_bx

/-- The owner `pcode.posX` lies within `D_edge` of any of its shell vertices `shellVertexPos pcode M sv`. -/
lemma posX_mem_ball3D_of_shellVertexPos {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (sv : ShellVertex pcode M)
    (hsv : shellVertexPos pcode M sv ∈ ball3D x0 r) :
    pcode.posX sv.val.1.val.1 ∈ ball3D x0 (r + 2 * D_edge) := by
  have hD0 := hD.1
  have h_self : pcode.posX sv.val.1.val.1 ∈ ball3D (pcode.posX sv.val.1.val.1) 0 := by
    dsimp [ball3D, distSq3D]; ring_nf; rfl
  have h_in_x := shellVertexPos_mem_ball3D_of_posX pcode M hD
    (pcode.posX sv.val.1.val.1) (le_refl 0) sv.val.1.val.1 h_self sv rfl
  rw [zero_add] at h_in_x
  dsimp [ball3D] at h_in_x
  rw [distSq3D_comm] at h_in_x
  exact ball3D_step_of_distSq3D_le x0 (shellVertexPos pcode M sv) (pcode.posX sv.val.1.val.1)
    hr (by linarith) hsv h_in_x

/-- The owner `pcode.posX` lies within `D_edge` of any of its boundary vertices `boundaryX0Pos pcode u`. -/
lemma posX_mem_ball3D_of_boundaryX0Pos {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (xv : BoundaryX0Link pcode M)
    (hxv : boundaryX0Pos pcode M xv.val.2 ∈ ball3D x0 r) :
    pcode.posX xv.val.1 ∈ ball3D x0 (r + 2 * D_edge) := by
  have hD0 := hD.1
  have h_self : pcode.posX xv.val.1 ∈ ball3D (pcode.posX xv.val.1) 0 := by
    dsimp [ball3D, distSq3D]; ring_nf; rfl
  have h_in_x := boundaryX0Pos_mem_ball3D_of_posX pcode M hD
    (pcode.posX xv.val.1) (le_refl 0) xv.val.1 h_self xv rfl
  rw [zero_add] at h_in_x
  dsimp [ball3D] at h_in_x
  rw [distSq3D_comm] at h_in_x
  exact ball3D_step_of_distSq3D_le x0 (boundaryX0Pos pcode M xv.val.2) (pcode.posX xv.val.1)
    hr (by linarith) hxv h_in_x

/-- Every cylinder X-check lies within `D_edge` of its coarse owner `pcode.posX`. -/
lemma bdlCylinderStepX_posX_mem_ball3D_of_ownerX {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (mX : BDLStepXMX pcode M)
    (hx : pcode.posX (stepXMXOwnerX pcode M mX) ∈ ball3D x0 r) :
    (bdlCylinderStepX pcode M).posX mX ∈ ball3D x0 (r + 2 * D_edge) := by
  have hD0 := hD.1
  rcases mX with ⟨x, b⟩ | ⟨sv, b⟩
  · exact ball3D_mono x0 hr (by linarith) hx
  · exact shellVertexPos_mem_ball3D_of_posX pcode M hD x0 hr sv.val.1.val.1 hx sv rfl

/-- The coarse owner `pcode.posX` lies within `D_edge` of any cylinder qubit `Sum.inl qX`. -/
lemma ownerX_mem_ball3D_of_bdlCylinderStepX_posQ_inl {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (qX : BDLCX1 pcode M)
    (hqX : (bdlCylinderStepX pcode M).posQ (Sum.inl qX) ∈ ball3D x0 r) :
    pcode.posX (qXOwnerX pcode M qX) ∈ ball3D x0 (r + 2 * D_edge) := by
  rcases qX with ⟨rv, b⟩ | ⟨⟨seg, b⟩ | ⟨xv, b⟩⟩
  · exact posX_mem_ball3D_of_shellVertexPos pcode M hD x0 hr rv.val hqX
  · exact posX_mem_ball3D_of_shellVertexPos pcode M hD x0 hr (shellSegEndVertex pcode M seg) hqX
  · exact posX_mem_ball3D_of_boundaryX0Pos pcode M hD x0 hr xv hqX

/-- Every internal disk Z-check `f_grid` lies within `D_edge` of its coarse owner `pcode.posX`. -/
lemma bdlCylinderStepX_posZ_grid_mem_ball3D_of_posX {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (x : M_X)
    (hx : pcode.posX x ∈ ball3D x0 r)
    (seg : ShellSegment pcode M) (b : Fin 3) (hseg : seg.val.1.val.1 = x) :
    (bdlCylinderStepX pcode M).posZ (Sum.inl (Sum.inl (seg, b))) ∈ ball3D x0 (r + 2 * D_edge) :=
  shellVertexPos_mem_ball3D_of_posX pcode M hD x0 hr x hx (shellSegEndVertex pcode M seg) hseg

/-- Every outer vertical collar Z-check `f_collar` lies within `D_edge` of its coarse owner `pcode.posX`. -/
lemma bdlCylinderStepX_posZ_collar_mem_ball3D_of_posX {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (x : M_X)
    (hx : pcode.posX x ∈ ball3D x0 r)
    (s : ActiveZLink pcode) (k : Fin (M + 1)) (b : Fin 2) (hs : s.val.1 = x) :
    (bdlCylinderStepX pcode M).posZ (Sum.inl (Sum.inr (s, k, b))) ∈ ball3D x0 (r + 2 * D_edge) :=
  boundaryX0Pos_mem_ball3D_of_posX pcode M hD x0 hr x hx (bxEndLink pcode M s k) hs

/-- Every star qubit `xq0Pos pcode M qQ` lies within `D_edge` of its coarse owner `pcode.posQ`. -/
lemma xq0Pos_mem_ball3D_of_ownerQ {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (v0 : Xq0 pcode M)
    (hq : pcode.posQ (xq0OwnerQ pcode M v0) ∈ ball3D x0 r) :
    xq0Pos pcode M v0 ∈ ball3D x0 (r + D_edge) := by
  rcases hD with ⟨hD0, hZ_edge, _⟩
  have hq' : pcode.posQ (xq0OwnerQ pcode M v0) ∈ ball3D x0 (r + D_edge) :=
    ball3D_mono x0 hr (by linarith) hq
  rcases v0 with q0 | ⟨⟨eZ, j⟩ | eZ⟩
  · exact hq'
  · have hz_in : pcode.posZ eZ.val.2 ∈ ball3D x0 (r + D_edge) :=
      ball3D_step_of_distSq3D_le x0 (pcode.posQ eZ.val.1) (pcode.posZ eZ.val.2) hr hD0 hq
        (by rw [distSq3D_comm]; exact hZ_edge eZ.val.2 eZ.val.1 eZ.property)
    exact subdividePoint3D_mem_ball3D x0 (pcode.posQ eZ.val.1) (pcode.posZ eZ.val.2)
      (M + 1) (j.val + 1) (r + D_edge) (by omega) hq' hz_in
  · exact ball3D_step_of_distSq3D_le x0 (pcode.posQ eZ.val.1) (pcode.posZ eZ.val.2) hr hD0 hq
      (by rw [distSq3D_comm]; exact hZ_edge eZ.val.2 eZ.val.1 eZ.property)

/-- The coarse owner `pcode.posQ` lies within `D_edge` of any of its star qubits `xq0Pos pcode M qQ`. -/
lemma ownerQ_mem_ball3D_of_xq0Pos {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (v0 : Xq0 pcode M)
    (hv0 : xq0Pos pcode M v0 ∈ ball3D x0 r) :
    pcode.posQ (xq0OwnerQ pcode M v0) ∈ ball3D x0 (r + D_edge) := by
  have hD0 := hD.1
  have h_self : pcode.posQ (xq0OwnerQ pcode M v0) ∈ ball3D (pcode.posQ (xq0OwnerQ pcode M v0)) 0 := by
    dsimp [ball3D, distSq3D]; ring_nf; rfl
  have h_in_q := xq0Pos_mem_ball3D_of_ownerQ pcode M hD
    (pcode.posQ (xq0OwnerQ pcode M v0)) (le_refl 0) v0 h_self
  rw [zero_add] at h_in_q
  dsimp [ball3D] at h_in_q
  rw [distSq3D_comm] at h_in_q
  exact ball3D_step_of_distSq3D_le x0 (xq0Pos pcode M v0) (pcode.posQ (xq0OwnerQ pcode M v0))
    hr hD0 hv0 h_in_q

/-- Every horizontal star-arm Z-check lies within `D_edge` of its coarse owner `pcode.posQ`. -/
lemma bdlCylinderStepX_posZ_arm_mem_ball3D_of_posQ {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (q0 : Q)
    (hq : pcode.posQ q0 ∈ ball3D x0 r)
    (eZ : ActiveZ pcode) (k : Fin (M + 1)) (b : Fin 3) (heZ : eZ.val.1 = q0) :
    (bdlCylinderStepX pcode M).posZ (Sum.inr (Sum.inl (Sum.inl (eZ, k, b)))) ∈ ball3D x0 (r + D_edge) := by
  change xq0Pos pcode M (armEnd pcode M eZ k) ∈ ball3D x0 (r + D_edge)
  apply xq0Pos_mem_ball3D_of_ownerQ pcode M hD x0 hr (armEnd pcode M eZ k)
  rw [xq0OwnerQ_armEnd, heZ]
  exact hq

/-- Every terminal vertical star Z-check lies within `D_edge` of its coarse owner `pcode.posQ`. -/
lemma bdlCylinderStepX_posZ_vert_mem_ball3D_of_posQ {Q M_Z M_X : Type}
    [Fintype Q] [DecidableEq Q] [Fintype M_Z] [DecidableEq M_Z] [Fintype M_X] [DecidableEq M_X]
    (pcode : CSSCode3D Q M_Z M_X) (M : ℕ) {D_edge : ℝ}
    (hD : HasCoarseEdgeBound pcode D_edge)
    (x0 : Point3D) {r : ℝ} (hr : 0 ≤ r) (q0 : Q)
    (hq : pcode.posQ q0 ∈ ball3D x0 r)
    (eZ : ActiveZ pcode) (b : Fin 2) (heZ : eZ.val.1 = q0) :
    (bdlCylinderStepX pcode M).posZ (Sum.inr (Sum.inl (Sum.inr (eZ, b)))) ∈ ball3D x0 (r + D_edge) := by
  change pcode.posZ eZ.val.2 ∈ ball3D x0 (r + D_edge)
  rw [← heZ] at hq
  exact ball3D_step_of_distSq3D_le x0 (pcode.posQ eZ.val.1) (pcode.posZ eZ.val.2) hr hD.1 hq
    (by rw [distSq3D_comm]; exact hD.2.1 eZ.val.2 eZ.val.1 eZ.property)

end WeldedHierarchy
