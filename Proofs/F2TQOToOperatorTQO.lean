import Defs.RescaledRCA

/-!
# Weyl-Pauli Projector Absorption and F_2-to-Operator TQO Stabilizer Decomposition

Proves the Weyl-Pauli ground-projector absorption identities X(b)(1 - Pi_X(b)) = 1 - Pi_X(b) and Z(a)(1 - Pi_Z(a)) = 1 - Pi_Z(a) (weylPauliX_mul_compl_checkProjX, weylPauliZ_mul_compl_checkProjZ) and shows that open-box F_2 Linear TQO (SatisfiesBoxF2LinearTQO) decomposes every locally commuting Pauli exponent vector supported on a cube into active check generators and inactive-slot pins inside the enclosing collar (boxF2LinearTQO_stabilizer_decomp).

## References

* Part I, Section 3.1 (`subsec:rca-trinity`), Definition 3.2 (`def:tqo`), Proposition 3.3 (`prop:trinity-equivalence`)
* Part I, Section 7.1 (`subsec:single-cube-telescoping`), Lemma 7.1 (`lem:norm-transfer`)
* Part II, Section 2 (`subsec:setup`), Definition 2.2 (`def:RCA`)
-/

noncomputable section

open scoped Classical BigOperators InnerProduct ComplexConjugate
open ContinuousLinearMap

/-! ## 1. Weyl–Pauli Stabilizer Absorption & $\mathbb{F}_2$ TQO $\implies$ Operator TQO -/

private lemma weylPauliX_mul_self_eq_one {L q_code : ℕ}
    (b : BoxSlot3D L q_code → ZMod 2) :
    weylPauliX b * weylPauliX b = 1 := by
  ext ψ σ
  change ψ.ofLp (flipCodeConfig b (flipCodeConfig b σ)) = ψ.ofLp σ
  rw [flipCodeConfig_involutive b σ]

private lemma weylPauliZ_mul_self_eq_one {L q_code : ℕ}
    (a : BoxSlot3D L q_code → ZMod 2) :
    weylPauliZ a * weylPauliZ a = 1 := by
  ext ψ σ
  change pauliPhase a (codeConfigBits σ) * (pauliPhase a (codeConfigBits σ) * ψ.ofLp σ) = ψ.ofLp σ
  rw [← mul_assoc, pauliPhase_mul_self, one_mul]

private lemma mul_compl_half_one_sub_of_sq_eq_one {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] {U : E →L[ℂ] E} (hU_sq : U * U = 1) :
    U * (1 - (2 : ℂ)⁻¹ • (1 - U)) = 1 - (2 : ℂ)⁻¹ • (1 - U) := by
  have h_mul : U * ((2 : ℂ)⁻¹ • (1 - U)) = (2 : ℂ)⁻¹ • (U - 1) := by
    ext x : 1
    simp only [ContinuousLinearMap.mul_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.sub_apply, ContinuousLinearMap.one_apply, map_smul, map_sub]
    have h_xx : U (U x) = x := congrFun (congrArg DFunLike.coe hU_sq) x
    rw [h_xx]
  rw [mul_sub, mul_one, h_mul]
  module

/-- Any $X$-check Weyl–Pauli generator $X(b)$ satisfies $X(b) (I - Q_X(b)) = I - Q_X(b)$. -/
theorem weylPauliX_mul_compl_checkProjX
    {L q_code : ℕ}
    (b : BoxSlot3D L q_code → ZMod 2) :
    weylPauliX b * (1 - weylCheckProjX b) = 1 - weylCheckProjX b :=
  mul_compl_half_one_sub_of_sq_eq_one (weylPauliX_mul_self_eq_one b)

/-- Any $Z$-check Weyl–Pauli generator $Z(a)$ satisfies $Z(a) (I - Q_Z(a)) = I - Q_Z(a)$. -/
theorem weylPauliZ_mul_compl_checkProjZ
    {L q_code : ℕ}
    (a : BoxSlot3D L q_code → ZMod 2) :
    weylPauliZ a * (1 - weylCheckProjZ a) = 1 - weylCheckProjZ a :=
  mul_compl_half_one_sub_of_sq_eq_one (weylPauliZ_mul_self_eq_one a)

/-- Under `ValidDescriptorField ω` and `SatisfiesBoxF2LinearTQO ω L_star C`, every Weyl–Pauli
    operator $Z(a) X(b)$ supported in $A = \mathrm{boxCube}(x_0, r)$ ($1 \le r \le L^*$) that commutes
    with all active local checks of $\omega$ in $B = \mathrm{enclosingBoxCube}(x_0, r, \mathrm{linearExpansionRadius}\ C\ r)$
    is generated by local stabilizer generators in $B$. -/
theorem boxF2LinearTQO_stabilizer_decomp
    {L q_code r_0 m_max : ℕ}
    (ω : Box3D L → LocalCSSDescriptor q_code r_0 m_max)
    (L_star : ℕ) (C : ℝ)
    (_h_valid : ValidDescriptorField ω)
    (h_f2_tqo : SatisfiesBoxF2LinearTQO ω L_star C)
    {r : ℕ} (hr1 : 1 ≤ r) (hrL : r ≤ L_star) (x0 : Box3D L)
    (a b : BoxSlot3D L q_code → ZMod 2)
    (ha_supp : BoxSlotChainSupportedIn a (boxCube x0 r))
    (hb_supp : BoxSlotChainSupportedIn b (boxCube x0 r))
    (hb_act : ∀ p : BoxSlot3D L q_code, b p ≠ 0 → (ω p.1).activeSlot p.2 = true)
    (ha_syn : ∀ (v : Box3D L) (idx : Fin m_max), idx.val < (ω v).numXChecks.val →
      (∑ p : BoxSlot3D L q_code, a p * descriptorCheckXChain ω v idx p) = 0)
    (hb_syn : ∀ (v : Box3D L) (idx : Fin m_max), idx.val < (ω v).numZChecks.val →
      (∑ p : BoxSlot3D L q_code, b p * descriptorCheckZChain ω v idx p) = 0) :
    let B := enclosingBoxCube x0 r (linearExpansionRadius C r)
    (∃ (c_pin : Box3D L × Fin q_code → ZMod 2) (c_Z : Box3D L × Fin m_max → ZMod 2),
      (∀ p, c_pin p ≠ 0 → (ω p.1).activeSlot p.2 = false ∧ p.1 ∈ B) ∧
      (∀ p, c_Z p ≠ 0 → p.2.val < (ω p.1).numZChecks.val ∧ boxBall p.1 r_0 ⊆ B) ∧
      a = (∑ p : Box3D L × Fin q_code, c_pin p • singleSlotChain p.1 p.2) +
          (∑ p : Box3D L × Fin m_max, c_Z p • descriptorCheckZChain ω p.1 p.2)) ∧
    (∃ c_X : Box3D L × Fin m_max → ZMod 2,
      (∀ p, c_X p ≠ 0 → p.2.val < (ω p.1).numXChecks.val ∧ boxBall p.1 r_0 ⊆ B) ∧
      b = ∑ p : Box3D L × Fin m_max, c_X p • descriptorCheckXChain ω p.1 p.2) := by
  have h_r := h_f2_tqo r hr1 hrL x0
  exact ⟨h_r.1 a ha_supp ha_syn, h_r.2 b hb_supp hb_act hb_syn⟩
