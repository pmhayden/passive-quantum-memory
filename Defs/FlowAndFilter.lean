/-!
# Heisenberg Time Evolution, Bochner Low-Pass Filters, and Kato-Hastings QAC Flows

Defines finite-dimensional unitary time evolution (`timeEvolutionOp`), Heisenberg observable evolution (`heisenbergFlow`, `LatticeHamiltonian.heisenbergEvolve`), continuous-time Bochner low-pass filtered operators (`bochnerFilteredOp`), Kato–Hastings quasi-adiabatic continuation generators (`katoHastingsGeneratorOp`), and non-autonomous Kato–Hastings differential flow systems (`IsKatoHastingsFlowSystem`).

## References

* Part I, Section 6.2 (`subsec:bochner-lr`), Proposition 6.3 (`prop:bochner-time-convolution`)
* Part I, Section 6.3 (`subsec:qac-block-diag`), Proposition 6.4 (`prop:qac-block-diagonalization`)
* Bravyi and Hastings (2011)
-/

noncomputable section

open scoped Classical InnerProduct ComplexConjugate BigOperators
open Filter Topology Asymptotics ContinuousLinearMap MeasureTheory

/-!
## 1. Unitary Time Evolution and Heisenberg Flow on `BoxD D L`
-/

/-- Unitary time-evolution operator $U_H(t) = \exp(i H t)$ generated by a Hamiltonian $H \in \mathcal{B}(\mathcal{H})$. -/
def timeEvolutionOp {D L : ℕ}
    {Site : BoxD D L → Type} [∀ x, Fintype (Site x)] [∀ x, DecidableEq (Site x)]
    (H : ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site) (t : ℝ) :
    ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site :=
  NormedSpace.exp ((Complex.I * (t : ℂ)) • H)

/-- Heisenberg time evolution $\tau_t^H(O) = e^{i H t} O e^{-i H t}$ of an observable $O \in \mathcal{B}(\mathcal{H})$. -/
def heisenbergFlow {D L : ℕ}
    {Site : BoxD D L → Type} [∀ x, Fintype (Site x)] [∀ x, DecidableEq (Site x)]
    (H : ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site) (t : ℝ)
    (O : ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site) :
    ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site :=
  timeEvolutionOp H t * O * timeEvolutionOp H (-t)

namespace LatticeHamiltonian

variable {D L : ℕ} {Site : BoxD D L → Type} [∀ x, Fintype (Site x)] [∀ x, DecidableEq (Site x)]
variable (H : LatticeHamiltonian D L Site)

/-- Heisenberg time evolution $A(t) = e^{i H_{\Lambda_L} t} A e^{-i H_{\Lambda_L} t}$ for a `LatticeHamiltonian`. -/
def heisenbergEvolve (t : ℝ)
    (A : ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site) :
    ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site :=
  heisenbergFlow H.totalHamiltonian t A

end LatticeHamiltonian

/-!
## 2. Genuine Bochner Time-Integral Filter $\mathcal{F}_\Delta^{(s)}$ and Kato–Hastings Generator $\mathcal{D}(s)$
-/

/-- **Continuous-Time Bochner-Integrated Filtered Heisenberg Operator (`bochnerFilteredOp`)**:
    $$\mathcal{F}_w^H(O) := \int_{-\infty}^\infty w(t) \, e^{i H t} O e^{-i H t} \, dt.$$
    This is the genuine Bochner time-integral low-pass filter of Bravyi–Hastings (2011) Section 4 Eq. (10)
    and Section 7 Lemma 7 (`rewrite1`), never replaced by a global algebraic projection. -/
def bochnerFilteredOp {D L : ℕ}
    {Site : BoxD D L → Type} [∀ x, Fintype (Site x)] [∀ x, DecidableEq (Site x)]
    (H : ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site)
    (w : ℝ → ℂ)
    (O : ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site) :
    ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site :=
  ∫ t : ℝ, w t • heisenbergFlow H t O

/-- **Kato–Hastings Quasi-Adiabatic Continuation Generator (`katoHastingsGeneratorOp`)**:
    $$\mathcal{D}_W^H(\partial_s H) := \int_{-\infty}^\infty W(t) \, e^{i H t} (\partial_s H) e^{-i H t} \, dt.$$
    When $W(t)$ is an odd imaginary filter weight ($W(-t) = -\overline{W(t)}$) and $H, \partial_s H$ are
    self-adjoint, $\mathcal{D}_W^H(\partial_s H)$ is self-adjoint and generates the unitary QAC flow. -/
def katoHastingsGeneratorOp {D L : ℕ}
    {Site : BoxD D L → Type} [∀ x, Fintype (Site x)] [∀ x, DecidableEq (Site x)]
    (H : ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site)
    (W : ℝ → ℂ)
    (dH : ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site) :
    ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site :=
  ∫ t : ℝ, W t • heisenbergFlow H t dH

/-!
## 3. Non-Autonomous Kato–Hastings Differential Flow System (`IsKatoHastingsFlowSystem`)
-/

/-- **Kato–Hastings Differential Flow System (`IsKatoHastingsFlowSystem`)**:
    Encapsulates a family of self-adjoint QAC generators $\mathcal{D} : \mathbb{R} \to \mathcal{B}(\mathcal{H})$,
    an evolution family $U : \mathbb{R} \to \mathcal{B}(\mathcal{H})$, and a spectral projection family
    $P : \mathbb{R} \to \mathcal{B}(\mathcal{H})$ satisfying the Kato–Hastings initial-value problem:
    - $U(0) = 1$ and $\frac{d}{ds} U(s) = i \, \mathcal{D}(s) \, U(s)$ for all $s \in \mathbb{R}$;
    - $P(0) = P_0$ and $\frac{d}{ds} P(s) = i \, (\mathcal{D}(s) P(s) - P(s) \mathcal{D}(s))$ for all $s \in \mathbb{R}$. -/
structure IsKatoHastingsFlowSystem {D L : ℕ}
    {Site : BoxD D L → Type} [∀ x, Fintype (Site x)] [∀ x, DecidableEq (Site x)]
    (P0 : ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site)
    (D_gen U P : ℝ → (ManyBodyHilbertSpace Site →L[ℂ] ManyBodyHilbertSpace Site)) : Prop where
  isSelfAdjoint_D : ∀ s : ℝ, IsSelfAdjoint (D_gen s)
  U_zero : U 0 = 1
  P_zero : P 0 = P0
  hasDerivAt_U : ∀ s : ℝ,
    HasDerivAt U ((Complex.I : ℂ) • (D_gen s * U s)) s
  hasDerivAt_P : ∀ s : ℝ,
    HasDerivAt P ((Complex.I : ℂ) • (D_gen s * P s - P s * D_gen s)) s
